# Copy to .env. Never commit .env.
# LLM provider for the copilot: "fake" (default, offline, deterministic) or "anthropic".
LLM_PROVIDER=fake
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
LOG_LEVEL=INFO

# n8n (compose profile "tools") sits behind an auth proxy that refuses to start without a password.
N8N_PROXY_USER=admin
N8N_PROXY_PASSWORD=

# Local-dev auth tokens (see docs/CONTRACTS.md §4.1). Override outside local dev.
INGEST_API_KEY=dev-ingest-key
COPILOT_ADMIN_TOKEN=dev-admin-token
MCP_TOKEN=dev-mcp-token
LOG_PSEUDONYM_KEY=dev-only-pseudonym-key
